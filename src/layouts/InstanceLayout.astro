---
import BaseLayout from './BaseLayout.astro'

interface Props {
  code: string
  title?: string
  description?: string
}

const { code, title, description } = Astro.props
const pageTitle = title ? `${code} — ${title} — Applied State` : `${code} — Applied State`
---

<BaseLayout title={pageTitle} description={description} pageClass="instance-page">
  <article class="instance" data-instance={code}>
    <header class="instance-header">
      <h1 class="instance-code">{code}</h1>
      {title && <p class="instance-title">{title}</p>}
    </header>

    <div class="instance-sequence">
      <slot />
    </div>

  </article>
</BaseLayout>
