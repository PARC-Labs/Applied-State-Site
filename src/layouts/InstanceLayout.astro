---
import BaseLayout from './BaseLayout.astro'

interface Props {
  code: string
  title?: string
  description?: string
  memberEnhanced?: boolean
}

const { code, title, description, memberEnhanced = false } = Astro.props
const pageTitle = title ? `${code} — ${title} — Applied State` : `${code} — Applied State`
const signInHref = `${import.meta.env.BASE_URL}signin/`
---

<BaseLayout title={pageTitle} description={description} pageClass="instance-page">
  <article class="instance" data-member-instance={code}>
    <header class="instance-header">
      <h1 class="instance-code">{code}</h1>
      {title && <p class="instance-title">{title}</p>}
    </header>

    <div class="instance-sequence">
      <slot />
    </div>

    {memberEnhanced && (
      <p class="member-note" data-member-note>
        Members have access to additional material. <a href={signInHref}>Sign in</a>.
      </p>
    )}
  </article>
</BaseLayout>
