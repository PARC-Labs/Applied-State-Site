---
interface Props {
  src: string
  caption?: string
  poster?: string
  width?: 'narrow' | 'medium' | 'wide'
}

const { src, caption, poster, width = 'wide' } = Astro.props
const withBase = (value: string | undefined) => {
  if (!value || !value.startsWith('/')) return value
  return `${import.meta.env.BASE_URL}${value.slice(1)}`
}
---

<figure class:list={['editorial-object', `editorial-object--${width}`]}>
  <video src={withBase(src)} poster={withBase(poster)} controls preload="metadata"></video>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
