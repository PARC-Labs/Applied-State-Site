---
const base = import.meta.env.BASE_URL
const href = (path: string) => `${base}${path}/`
---

<footer class="site-footer">
  <nav class="utility-nav" aria-label="Utility navigation">
    <a href={href('about')}>ABOUT</a>
    <a href={href('membership')}>MEMBERSHIP</a>
    <a href={href('states')} data-member-visible="active" hidden>STATES</a>
    <a href={href('index')} data-member-visible="index" hidden>INDEX</a>
    <a href={href('index/review')} data-member-visible="staff" hidden>REVIEW</a>
    <a href={href('signin')} data-member-signin-link>SIGN IN</a>
    <button class="text-action" type="button" data-member-signout hidden>SIGN OUT</button>
  </nav>
</footer>
