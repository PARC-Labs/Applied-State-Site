---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import ArenaChannel from '../components/ArenaChannel.astro'
import InstanceLayout from '../layouts/InstanceLayout.astro'

export async function getStaticPaths() {
  const entries = await getCollection('instances', ({ data }) => data.status !== 'draft')

  return entries.map((entry) => ({
    params: { instance: entry.data.code.toLowerCase() },
    props: { entry },
  }))
}

interface Props {
  entry: CollectionEntry<'instances'>
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<InstanceLayout
  code={entry.data.code}
  title={entry.data.title}
  description={entry.data.summary}
  memberEnhanced={entry.data.memberEnhanced}
>
  {entry.data.arenaChannel && (
    <ArenaChannel channel={entry.data.arenaChannel} instanceCode={entry.data.code} />
  )}
  <Content />
</InstanceLayout>
