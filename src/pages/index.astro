---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const entries = (await getCollection('instances', ({ data }) => data.status !== 'draft'))
  .sort((a, b) => a.data.code.localeCompare(b.data.code, undefined, { numeric: true }))
const base = import.meta.env.BASE_URL
---

<BaseLayout pageClass="home-page" homeHeading>
  <nav class="instance-index" aria-label="Applied State instances">
    <ol>
      {entries.map((entry) => (
        <li><a href={`${base}${entry.data.code.toLowerCase()}/`}>{entry.data.code}</a></li>
      ))}
    </ol>
  </nav>
</BaseLayout>
