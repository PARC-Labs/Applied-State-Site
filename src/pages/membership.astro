---
import BaseLayout from '../layouts/BaseLayout.astro'
import { ADMISSION_INTAKE_OPEN } from '../lib/admission-release'

const signInHref = `${import.meta.env.BASE_URL}signin/`
---

<BaseLayout title="Membership — Applied State" pageClass="utility-page">
  <article class="utility-document">
    <h1>MEMBERSHIP</h1>
    <div class="utility-copy">
      <p>Applied State is a distributed art and research institution. Membership supports its work and provides access to additional research materials, private States, selected collaboration, and the member Index.</p>
      <p>Admission is selective, by application or invitation. Accepted applicants receive payment and account instructions privately. Admission does not confer editorial publication rights.</p>
      {ADMISSION_INTAKE_OPEN ? (
        <p><a href={`${import.meta.env.BASE_URL}apply/`}>Apply for membership</a></p>
      ) : (
        <p>Applications are not currently open.</p>
      )}
      <p><a href={signInHref}>Member sign in</a></p>
    </div>
  </article>
</BaseLayout>
