{
  "name": "applied-state-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": ">=22.12 <26"
  },
  "scripts": {
    "predev": "node scripts/validate-public-env.mjs --mode development",
    "dev": "astro dev",
    "prebuild": "node scripts/validate-public-env.mjs --mode production",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:leakage": "node scripts/check-public-build.mjs",
    "verify": "npm run check && npm run test:unit && npm run build && npm run test:leakage"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.0",
    "@supabase/supabase-js": "2.114.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "6.0.3"
  }
}
