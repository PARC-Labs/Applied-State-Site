# Astro exposes PUBLIC_* values to every visitor. Use only a Supabase
# publishable key (or legacy anon key); never use a secret/service-role key.
# These may be omitted together for public-only work. Member functions activate
# only when both production repository variables are configured.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Static build location. GitHub Actions supplies production Pages values.
SITE_URL=http://localhost:4321
BASE_PATH=/
